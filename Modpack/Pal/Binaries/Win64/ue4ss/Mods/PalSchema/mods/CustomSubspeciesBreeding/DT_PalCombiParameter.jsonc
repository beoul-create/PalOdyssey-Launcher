{
  // Row format: Parent 1 + Parent 2 = Child Variant
  // Order of parents does not matter in Palworld's combi lookup.

  // Example 1: Foxparks (Fire) + Kelpsea (Water) = Foxparks_Aqua (Water/Ice)
  "Foxparks_Aqua_Combi": {
    "TribeA": "EPalTribeID::Kitsunebi", // Foxparks Internal ID
    "TribeB": "EPalTribeID::Kelpie",    // Kelpsea Internal ID
    "Child": "EPalTribeID::Foxparks_Aqua"
  },

  // Example 2: Orserk (Electric/Dragon) + Digtoise (Ground) = Orserk_Terra (Ground/Dragon)
  "Orserk_Terra_Combi": {
    "TribeA": "EPalTribeID::ThunderDragonMan", // Orserk Internal ID
    "TribeB": "EPalTribeID::DrillGame",        // Digtoise Internal ID
    "Child": "EPalTribeID::Orserk_Terra"
  },

  // Example 3: Chillet (Ice/Dragon) + Flambelle (Fire) = Chillet_Ignis (Fire/Dragon)
  "Chillet_Ignis_Combi": {
    "TribeA": "EPalTribeID::IceFox",
    "TribeB": "EPalTribeID::FireKitsunebi",
    "Child": "EPalTribeID::Chillet_Ignis"
  },

  // Example 4: Anubis (Ground) + Relaxaurus (Water/Dragon) = Anubis_Hydro (Water/Ground)
  "Anubis_Hydro_Combi": {
    "TribeA": "EPalTribeID::Anubis",
    "TribeB": "EPalTribeID::LazyDragon",
    "Child": "EPalTribeID::Anubis_Hydro"
  },

  // Self-Breeding Subspecies (Breeding two variants produces the same variant)
  "Foxparks_Aqua_Self": {
    "TribeA": "EPalTribeID::Foxparks_Aqua",
    "TribeB": "EPalTribeID::Foxparks_Aqua",
    "Child": "EPalTribeID::Foxparks_Aqua"
  },

  "Orserk_Terra_Self": {
    "TribeA": "EPalTribeID::Orserk_Terra",
    "TribeB": "EPalTribeID::Orserk_Terra",
    "Child": "EPalTribeID::Orserk_Terra"
  },

  "Chillet_Ignis_Self": {
    "TribeA": "EPalTribeID::Chillet_Ignis",
    "TribeB": "EPalTribeID::Chillet_Ignis",
    "Child": "EPalTribeID::Chillet_Ignis"
  },

  "Anubis_Hydro_Self": {
    "TribeA": "EPalTribeID::Anubis_Hydro",
    "TribeB": "EPalTribeID::Anubis_Hydro",
    "Child": "EPalTribeID::Anubis_Hydro"
  }
}
