    "DT_PalDescriptionText": {
        "PAL_DESC_Lamball_Ignis": "A fiery Lamball coated in heat-resistant volcanic fleece. It rolls at high speeds leaving trails of fire.",
        "PAL_DESC_Cattiva_Noct": "A nocturnal Cattiva cloaked in shadows. Its cowardice has been replaced by cunning ambush tactics.",
        "PAL_DESC_Chikipi_Electricity": "A supercharged Chikipi infused with lightning. Its rapid pecks deliver sharp electric shocks.",
        "PAL_DESC_Lifmunk_Noct": "A shadow-dwelling Lifmunk that snipes enemies with shadowy projectiles under the moonlight.",
        "PAL_DESC_Foxparks_Aqua": "A variant of Foxparks adapted to coastal waters. It exhales high-pressure water jets instead of fire.",
        "PAL_DESC_Fuack_Ignis": "A blazing Fuack that slides across terrain on a wave of superheated steam.",
        "PAL_DESC_Sparkit_Aqua": "An aquatic Sparkit whose electrified whiskers generate underwater shock pulses.",
        "PAL_DESC_Tanzee_Aqua": "A river-dwelling Tanzee that wields high-pressure water rifles with incredible accuracy.",
        "PAL_DESC_Rooby_Cryst": "A crystalline Rooby whose hooves leave glittering sheets of ice wherever it steps.",
        "PAL_DESC_Pengullet_Ignis": "A volcanic Pengullet loaded with volatile explosive embers.",
        "PAL_DESC_Penking_Lux": "The regal lightning emperor who conducts oceanic electrical storms.",
        "PAL_DESC_Jolthog_Ignis": "A bristling fiery hedgehog that ignites its quills when threatened.",
        "PAL_DESC_Jolthog_Terra": "An earthen hedgehog that sheds hardened crystalline geodes.",
        "PAL_DESC_Gumoss_Ignis": "A molten gel Pal that bubbles with geothermal heat.",
        "PAL_DESC_Vixy_Noct": "A mystical twilight fox that digs up rare nocturnal curiosities from underground.",
        "PAL_DESC_Hoocrates_Lux": "An enlightened scholarly bird illuminated by crackling arcane lightning.",
        "PAL_DESC_Teafant_Ignis": "A gentle creature whose trunk sprays soothing thermal springwater.",
        "PAL_DESC_Depresso_Lux": "Caffeinated beyond mortal limits. Constant electric discharges keep this Depresso perpetually vibrating.",
        "PAL_DESC_Daedream_Lux": "A celestial spirit dancing between stormclouds, unleashing brilliant spark bolts.",
        "PAL_DESC_Rushoar_Aqua": "An amphibious charging boar that bursts through rocky shores like a battering ram.",
        "PAL_DESC_Direhowl_Cryst": "A northern frost wolf that glides across glacial peaks at breakneck speeds.",
        "PAL_DESC_Fuddler_Aqua": "An aquatic mole specialized in dredging deep underwater riverbeds.",
        "PAL_DESC_Killamari_Ignis": "A floating volcanic squid that glides through hot thermal updrafts.",
        "PAL_DESC_Mau_Ignis": "A sacred gold-seeking feline that bathes in molten ore and produces fiery nuggets.",
        "PAL_DESC_Mau_Lux": "An energized feline that collects magnetized relic fragments.",
        "PAL_DESC_Flopie_Noct": "A fairy rabbit adorned in shadow lilies that hovers quietly behind its partner.",
        "PAL_DESC_Mozzarina_Ignis": "A fiery bovoid whose milk is infused with warming spices and natural stamina.",
        "PAL_DESC_Bristla_Ignis": "A blazing desert cactus that launches burning needle barrages.",
        "PAL_DESC_Gobfin_Lux": "A volatile sea goblin that charges itself with static currents before swarming.",
        "PAL_DESC_Gobfin_Cryst": "An arctic Gobfin armed with razor-sharp ice spears.",
        "PAL_DESC_Hangyu_Aqua": "A floating water spirit that lifts its tamer on rising geyser winds.",
        "PAL_DESC_Hangyu_Ignis": "A blazing aerial bell whose ringing unleashes scorching sonic waves.",
        "PAL_DESC_Tocotoco_Noct": "A sneaky nocturnal bird that lays silent shadow bombs in the dead of night.",
        "PAL_DESC_Chillet_Terra": "A gentle serpentine dragon burrowing through bedrock and mineral veins with playful ease.",
        "PAL_DESC_Digtoise_Aqua": "An amphibious Digtoise that drills into undersea mineral deposits with pressurized hydro-vortexes.",
        "PAL_DESC_Caprity_Cryst": "A mountain caprine sprouting frost berries that cure hypothermia.",
        "PAL_DESC_Melpaca_Ignis": "An exceptionally fluffy alpaca whose fleece radiates constant gentle warmth.",
        "PAL_DESC_Eikthyrdeer_Noct": "A spectral stag whose majestic antlers channel midnight starlight.",
        "PAL_DESC_Eikthyrdeer_Aqua": "A graceful water stag that bounds across lakes without disturbing the surface.",
        "PAL_DESC_Nitewing_Ignis": "A solar bird of prey that dives from the clouds enveloped in blinding flames.",
        "PAL_DESC_Ragnahawk_Cryst": "An armored frost raptor that glides silently through blizzard skies.",
        "PAL_DESC_Dumud_Cryst": "An iceberg fish that slides effortlessly across frozen glaciers.",
        "PAL_DESC_Maraith_Ignis": "A hellhound emissary that guides lost spirits with its blue ghostly lantern flames.",
        "PAL_DESC_Robinquill_Aqua": "A coastal archer that looses pressurized water arrows capable of piercing solid stone.",
        "PAL_DESC_Robinquill_Ignis": "A desert marksman whose arrows detonate into fiery explosions upon impact.",
        "PAL_DESC_Gorirat_Aqua": "A heavyweight primate that pummels foes with devastating tidal shockwaves.",
        "PAL_DESC_Gorirat_Cryst": "An arctic gorilla whose frozen fists smash boulders into powder.",
        "PAL_DESC_Ribbuny_Noct": "A gothic bunny that manufactures sinister contraptions under shadow cover.",
        "PAL_DESC_Elizabee_Noct": "A sovereign queen of the dark hive whose sting injects shadow venom.",
        "PAL_DESC_Beegarde_Ignis": "A zealous worker bee whose stinger burns with blazing furnace heat.",
        "PAL_DESC_Katress_Aqua": "An aquatic sorceress who weaves tidal enchantments beneath ocean waves.",
        "PAL_DESC_Grintale_Cryst": "A frozen smiling behemoth that rests happily atop snowy hilltops.",
        "PAL_DESC_Swee_Ignis": "A fiery fluffball that clusters together to heat cold mountain caves.",
        "PAL_DESC_Sweepa_Ignis": "The towering blazing fluff king who commands a legion of flame Swees.",
        "PAL_DESC_Foxcicle_Ignis": "A graceful kitsune enveloped in swirling solar ribbons of flame.",
        "PAL_DESC_Pyrin_Aqua": "A mythical aquatic steed that gallops across tidal foam with unmatched grace.",
        "PAL_DESC_Pyrin_Cryst": "A northern pegasus that charges through blizzards leaving crystalline hoofprints.",
        "PAL_DESC_Reindrix_Ignis": "A volcanic stag whose horns glow like superheated smithing tongs.",
        "PAL_DESC_Dazzi_Aqua": "A cheerful water sprite who floats atop bubbly rainclouds.",
        "PAL_DESC_Galeclaw_Lux": "A storm eagle that carries its tamer through roaring thunderheads.",
        "PAL_DESC_Dinossom_Aqua": "A tropical dragon whose blooming crown emits soothing ocean mists.",
        "PAL_DESC_Dinossom_Ignis": "A volcanic flora dragon whose blossom radiates intense solar heat.",
        "PAL_DESC_Surfent_Cryst": "A glacial serpent that carves deep channels through frozen sea ice.",
        "PAL_DESC_Surfent_Ignis": "A magma serpent swimming through underground molten rivers.",
        "PAL_DESC_Menasting_Aqua": "A heavy chitinous scorpion that hunts in deep oceanic trenches.",
        "PAL_DESC_Menasting_Ignis": "A forge scorpion whose venomous tail injects liquid magma.",
        "PAL_DESC_Lovander_Cryst": "A cold-hearted nocturnal hunter that seeks affection in glacial peaks.",
        "PAL_DESC_Mossanda_Cryst": "A frosty panda that hurls massive snowballs and slides playfully down icy slopes.",
        "PAL_DESC_Mossanda_Terra": "A mountain gorilla panda equipped with seismic boulder launchers.",
        "PAL_DESC_Kingpaca_Ignis": "The majestic lord of wool whose blazing aura repels all chill.",
        "PAL_DESC_Kingpaca_Lux": "A supercharged alpaca monarch adorned with electric crowns.",
        "PAL_DESC_Wumpo_Ignis": "A colossal yeti that discovered the warmth of volcanoes and carries fiery boulders.",
        "PAL_DESC_Wumpo_Cryst": "An ancient frost guardian rooted in perpetual winter.",
        "PAL_DESC_Fenglope_Ignis": "A celestial stag that leaps through fiery skies leaving blazing contrails.",
        "PAL_DESC_Grizzbolt_Dark": "An intimidating nocturnal behemoth that stalks dense forests under the cover of thunderstorm skies.",
        "PAL_DESC_Grizzbolt_Terra": "A subterranean Grizzbolt that uses heavy stone miniguns to tunnel through bedrock.",
        "PAL_DESC_Mammorest_Aqua": "A primeval behemoth covered in marine flora that creates tidal waves with every step.",
        "PAL_DESC_Mammorest_Ignis": "A primordial mammoth whose volcanic trunk shoots searing magma geysers.",
        "PAL_DESC_Lyleen_Ignis": "A majestic solar sovereign blooming with radiant solar flames that invigorate allies.",
        "PAL_DESC_Lyleen_Aqua": "An oceanic queen presiding over deep abyssal coral sanctuaries.",
        "PAL_DESC_Astegon_Aqua": "A deep-abyss metal dragon reinforced against crushing ocean depths.",
        "PAL_DESC_Anubis_Cryst": "The glacial guardian of ancient frozen tombs. Master of high-speed icy martial arts.",
        "PAL_DESC_Jormuntide_Cryst": "The mythical frost serpent of the deep abyss, encasing entire waterways in unbreakable glaciers.",
        "PAL_DESC_Jormuntide_Terra": "The legendary earth serpent that burrows deep through tectonic faultlines.",
        "PAL_DESC_Suzaku_Cryst": "A celestial frost bird that commands sub-zero blizzards across high peaks.",
        "PAL_DESC_Suzaku_Terra": "An earthen phoenix that glides over arid canyons like a golden sandstorm.",
        "PAL_DESC_Helzephyr_Aqua": "A supernatural harbinger that rides the mist above tumultuous midnight seas.",
        "PAL_DESC_Necromus_Cryst": "The black frost knight who pierces enemies with lances of unmelting black ice.",
        "PAL_DESC_Paladius_Ignis": "The holy knight of radiant solar dawn whose burning shield deflects all darkness.",
        "PAL_DESC_Jetragon_Frost": "A supersonic celestial dragon enveloped in sub-zero atmospheric vapor.",
        "PAL_DESC_Frostallion_Ignis": "A celestial pegasus consumed by eternal primordial fire, soaring across scorching volcanic skies.",
        "PAL_DESC_Frostallion_Aqua": "A radiant abyssal steed whose aquatic wings glide through oceanic thermals.",
        "PAL_DESC_Shadowbeak_Aqua": "A biomechanical chimeric dragon engineered with high-pressure hydro thrusters.",
        "PAL_DESC_Orserk_Terra": "A colossal dragon that channels seismic fault energy directly into titanic earthen shockwaves.",
        "PAL_DESC_Blazamut_Aqua": "A deep-sea volcanic dragon capable of generating scalding hydrothermic eruptions.",
        "PAL_DESC_Relaxaurus_Terra": "A heavy, content dragon covered in moss and rocky slabs that loves nothing more than sunbathing in dirt.",
        "PAL_DESC_Relaxaurus_Noct": "A drowsy dragon that sleepwalks through midnight glades with eerie complacency.",
        "PAL_DESC_Faleris_Aqua": "A graceful desert falcon that soars through oasis mists, creating refreshing rainstorms.",
        "PAL_DESC_Faleris_Terra": "A sand falcon that sweeps across dunes generating blinding dust storms.",
        "PAL_DESC_Selyne_Ignis": "A radiant solar sovereign that reigns over twilight skies with golden coronal flares.",
        "PAL_DESC_Xenogard_Aqua": "A celestial meteorite dragon that crashed into deep abyssal trenches.",
        "PAL_DESC_Incineram_Aqua": "A demonic beast that hunts along foggy lakebeds with razor-sharp aquatic claws.",
        "PAL_DESC_Incineram_Cryst": "A nocturnal fiend that stalks blizzard plains, freezing its prey with a single touch.",
        "PAL_DESC_Xenovader_Ignis": "An extraterrestrial invader powered by stellar plasma cores.",
        "PAL_DESC_Sibelyx_Ignis": "A silken moth whose iridescent wings scatter shimmering hot embers.",
        "PAL_DESC_Sibelyx_Aqua": "A graceful moth producing moisture-locking silk of the highest grade.",
        "PAL_DESC_Warsect_Aqua": "An amphibious armored stag beetle whose carapace deflects high-pressure undersea depth charges.",
        "PAL_DESC_Warsect_Ignis": "A volcanic beetle clad in tempered obsidian plate that thrives near caldera vents.",
        "PAL_DESC_Skutlass_Cryst": "A swift maritime duelist wielding cutlasses forged from sub-zero iceberg glass.",
        "PAL_DESC_Skutlass_Lux": "A blazing swashbuckler whose electrified rapiers arc with discharge upon each strike."
    }
}