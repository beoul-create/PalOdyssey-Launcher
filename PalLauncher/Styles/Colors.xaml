<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep Void & Obsidian Cyber Backgrounds -->
    <Color x:Key="ColorBgVoid">#06080E</Color>
    <Color x:Key="ColorBgDark">#090D15</Color>
    <Color x:Key="ColorBgSurface">#0E1422</Color>
    <Color x:Key="ColorBgCard">#131B2C</Color>
    <Color x:Key="ColorBgCardHover">#1A253C</Color>
    <Color x:Key="ColorBgInput">#080C14</Color>
    <Color x:Key="ColorBorder">#1E2C44</Color>
    <Color x:Key="ColorBorderGlow">#00F0FF</Color>

    <!-- Futuristic Holographic Accents -->
    <Color x:Key="ColorAccentCyan">#00F0FF</Color>
    <Color x:Key="ColorAccentPurple">#A855F7</Color>
    <Color x:Key="ColorAccentMagenta">#EC4899</Color>
    <Color x:Key="ColorAccentOrange">#F97316</Color>
    <Color x:Key="ColorAccentOrangeLight">#FB923C</Color>

    <!-- Status Colors -->
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorError">#EF4444</Color>
    <Color x:Key="ColorInfo">#00F0FF</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBgVoid" Color="{StaticResource ColorBgVoid}" />
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource ColorAccentOrange}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Futuristic Hologram & Cyber Gradients -->
    <LinearGradientBrush x:Key="BrushLaunchGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0.0" />
        <GradientStop Color="#8B5CF6" Offset="0.6" />
        <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushLaunchGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#A855F7" Offset="0.6" />
        <GradientStop Color="#F43F5E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyanGlowGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F0FF" Offset="0.0" />
        <GradientStop Color="#A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHologramBeam" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000F0FF" Offset="0.0" />
        <GradientStop Color="#6600F0FF" Offset="0.5" />
        <GradientStop Color="#00A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHologramActiveTab" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2200F0FF" Offset="0.0" />
        <GradientStop Color="#11A855F7" Offset="0.7" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E1422" Offset="0.0" />
        <GradientStop Color="#090D15" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardGlowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#182338" Offset="0.0" />
        <GradientStop Color="#111827" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyberBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3300F0FF" Offset="0.0" />
        <GradientStop Color="#1E2C44" Offset="0.5" />
        <GradientStop Color="#33A855F7" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
