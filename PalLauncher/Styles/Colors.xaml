<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimalist Obsidian & Slate Backgrounds -->
    <Color x:Key="ColorBgVoid">#080B10</Color>
    <Color x:Key="ColorBgDark">#0C1017</Color>
    <Color x:Key="ColorBgSurface">#121721</Color>
    <Color x:Key="ColorBgCard">#161E2C</Color>
    <Color x:Key="ColorBgCardHover">#1C2638</Color>
    <Color x:Key="ColorBgInput">#0A0E15</Color>
    <Color x:Key="ColorBorder">#1F2B3E</Color>
    <Color x:Key="ColorBorderGlow">#38BDF8</Color>

    <!-- Minimalist Accents -->
    <Color x:Key="ColorAccentCyan">#38BDF8</Color>
    <Color x:Key="ColorAccentPurple">#818CF8</Color>
    <Color x:Key="ColorAccentOrange">#F97316</Color>
    <Color x:Key="ColorAccentOrangeLight">#FB923C</Color>

    <!-- Status Colors -->
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorError">#EF4444</Color>
    <Color x:Key="ColorInfo">#38BDF8</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F1F5F9</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBgVoid" Color="{StaticResource ColorBgVoid}" />
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource ColorAccentOrange}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="BrushLaunchGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EA580C" Offset="0.0" />
        <GradientStop Color="#F97316" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushLaunchGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0.0" />
        <GradientStop Color="#FB923C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyanGlowGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#818CF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121721" Offset="0.0" />
        <GradientStop Color="#0C1017" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardGlowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E283A" Offset="0.0" />
        <GradientStop Color="#161E2C" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
