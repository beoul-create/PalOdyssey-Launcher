<UserControl x:Class="PalLauncher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PalLauncher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="880">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,16">

            <!-- Futuristic Holographic Hero Card with Astralym Artwork -->
            <Border CornerRadius="12" Margin="0,0,0,16" Background="{StaticResource BrushCardGlowGradient}" BorderBrush="{StaticResource BrushCyberBorderGradient}" BorderThickness="1.5" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#00F0FF" Opacity="0.15" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Astralym Emblem -->
                    <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1.5" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#00F0FF" Opacity="0.75" ShadowDepth="0" />
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/astralym_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Center: Title & News Broadcast -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ASTRAL REALM ONLINE" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#101827" BorderBrush="{StaticResource BrushAccentPurple}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OPTIMIZED BUILD" Foreground="{StaticResource BrushAccentPurple}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Ready for the Next Expedition" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding NewsAnnouncement}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" MaxWidth="500" LineHeight="16" />
                    </StackPanel>

                    <!-- Right: Minimal Server Endpoint Pill -->
                    <Border Grid.Column="2" Background="#0A0E18" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="REALM ENDPOINT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SettingsVM.ServerIp}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text=":" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                                <TextBlock Text="{Binding SettingsVM.ServerPort}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                            </StackPanel>
                            <Button Content="Server Config" Style="{StaticResource StyleGhostButton}" Padding="8,3" FontSize="10" HorizontalAlignment="Left"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Futuristic 3-Card Status Matrix -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Palworld Client Status -->
                <Border Grid.Column="0" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="GAME CLIENT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SettingsVM.PathStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SettingsVM.CurrentPathInfo.DetectedSource, StringFormat='Source: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Palworld Dedicated Server Status -->
                <Border Grid.Column="2" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="DEDICATED REALM" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="beoul.duckdns.org:8211" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ServerStatusBadgeText}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Launch Profile -->
                <Border Grid.Column="4" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE MODE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#101827" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="Raw Input + 1MB/s Net" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="PalOdysseyOptimizer Active" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dedicated Server Remote Liveboard Card -->
            <Border Style="{StaticResource StyleCardBorder}" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoteServerOnline}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="LIVEBOARD TELEMETRY" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RemoteServerLiveboard.ServerName, FallbackValue='PalOdyssey Realm'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding RemoteServerLiveboard.UptimeFormatted, StringFormat='Uptime: {0}', FallbackValue='Uptime: Online'}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding RemoteServerLiveboard.PlayerCountFormatted, FallbackValue='Players: 0/32'}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Inspect Server" Style="{StaticResource StyleGhostButton}" Padding="10,6" FontSize="11" Margin="0,0,8,0"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        <Button Content="Wake / Start Server" Style="{StaticResource StyleCyanButton}" Padding="12,6" FontSize="11"
                                Command="{Binding WakeRemoteServerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Crash Doctor / Quick Health Action Card -->
            <Border Style="{StaticResource StyleCardBorder}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconBug}" Fill="{StaticResource BrushAccentOrange}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="PALODYSSEY CRASH DOCTOR &amp; LOG ANALYZER" Foreground="{StaticResource BrushAccentOrange}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Automated stack trace symbolizer and crash dump inspection utility." Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource StyleGhostButton}" Padding="12,6" VerticalAlignment="Center"
                            Command="{Binding OpenCrashDoctorCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushAccentCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Inspect Crashes" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
