<UserControl x:Class="PalLauncher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PalLauncher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:BooleanToBrushConverter x:Key="PathValidToBrush" TrueBrush="{StaticResource BrushSuccess}" FalseBrush="{StaticResource BrushWarning}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,16">

            <!-- 1. Holographic Hero Banner with Astralym Artwork -->
            <Border CornerRadius="12" Margin="0,0,0,14" Background="{StaticResource BrushCardGlowGradient}" BorderBrush="{StaticResource BrushCyberBorderGradient}" BorderThickness="1.5" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#00F0FF" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Astralym Emblem -->
                    <Border Grid.Column="0" Width="68" Height="68" CornerRadius="14" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1.5" Margin="0,0,18,0" VerticalAlignment="Center" ClipToBounds="True" SnapsToDevicePixels="True" Background="#0C1018">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#00F0FF" Opacity="0.75" ShadowDepth="0" />
                        </Border.Effect>
                        <Border CornerRadius="12" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/emblem_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                        </Border>
                    </Border>

                    <!-- Center & Right: Title & News Broadcast (Responsive full-width wrapping) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#101827" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PalOdyssey" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="A server created with multiple people" Foreground="{StaticResource BrushTextPrimary}" FontSize="19" FontWeight="Bold" Margin="0,3,0,6" />
                        <TextBlock Text="{Binding NewsAnnouncement}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Account & Expedition Identity Bar (Steam Profile & Discord Link) -->
            <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Steam Pioneer Profile -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮 PIONEER:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SteamProfile.PersonaName, FallbackValue='Steam Pioneer'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SteamProfile.SteamId64, StringFormat='(ID: {0})', FallbackValue='(Steam Offline)'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                        
                        <!-- Discord Linked Badge -->
                        <Border Background="#1A1F2E" BorderBrush="{StaticResource BrushAccentPurple}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DiscordLinkBadge}" Foreground="{StaticResource BrushAccentPurple}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Connect / Unlink Discord Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Connect Steam" Style="{StaticResource StyleGhostButton}" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                                Command="{Binding ConnectSteamCommand}"
                                Visibility="{Binding SteamProfile.IsDetected, Converter={StaticResource InvertBoolToVis}}" />
                        <Button Content="Connect Discord" Style="{StaticResource StyleCyanButton}" FontSize="11" Padding="10,4" Margin="0,0,8,0"
                                Command="{Binding ConnectDiscordCommand}"
                                Visibility="{Binding IsDiscordLinked, Converter={StaticResource InvertBoolToVis}}" />
                        <Button Content="Unlink" Style="{StaticResource StyleGhostButton}" FontSize="11" Padding="8,4"
                                Command="{Binding UnlinkDiscordCommand}"
                                Visibility="{Binding IsDiscordLinked, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Game Client Status Bar -->
            <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheckCircle}" Fill="{Binding SettingsVM.IsPathValid, Converter={StaticResource PathValidToBrush}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="GAME CLIENT:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SettingsVM.PathStatusText}" Foreground="{Binding SettingsVM.IsPathValid, Converter={StaticResource PathValidToBrush}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding SettingsVM.CurrentPathInfo.DetectedSource, StringFormat='({0})'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Installation Settings" Style="{StaticResource StyleGhostButton}" FontSize="11" Padding="10,4"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </Grid>
            </Border>

            <!-- 3. Prominent Dedicated Server Liveboard Screen -->
            <Border Style="{StaticResource StyleCardBorder}" Padding="20,16" Margin="0,0,0,0" Background="{StaticResource BrushBgCard}">
                <StackPanel>
                    <!-- Liveboard Header Bar -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Liveboard Title & Pulse Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentCyan}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#00F0FF" Opacity="0.8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock Text="REALM LIVEBOARD &amp; TELEMETRY" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            
                            <Border Background="#121824" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Liveboard.Version, StringFormat='v{0}', FallbackValue='v1.5.4'}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Border Background="#16243A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Liveboard.FpsBadge, FallbackValue='60 FPS'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Right: Interactive 1-Click Server IP Copy Button Badge -->
                        <Button Grid.Column="1" Style="{StaticResource StyleGhostButton}"
                                Command="{Binding CopyServerIpCommand}"
                                ToolTip="Click to copy server address to clipboard"
                                Background="#0A0E18" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SERVER ENDPOINT:" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Liveboard.ServerAddress, FallbackValue='palodyssey.duckdns.org:8211'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Background="#16243A" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="COPY" Foreground="{StaticResource BrushAccentCyan}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Telemetry Metrics Grid (4 Stat Cards) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Online Status & Power State -->
                        <Border Grid.Column="0" Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SERVER STATUS" Foreground="{StaticResource BrushTextMuted}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Check" Style="{StaticResource StyleGhostButton}" FontSize="9" Padding="4,1"
                                            Command="{Binding RefreshServerStatusCommand}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding ServerStatusBadgeText, FallbackValue='Detecting...'}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Liveboard.AutoShutdownStatusText, FallbackValue='Auto-Wake Enabled on Launch'}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 2: Active Explorers -->
                        <Border Grid.Column="2" Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="ONLINE EXPLORERS" Foreground="{StaticResource BrushTextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Liveboard.OccupancySummary, FallbackValue='0 / 32 (0%)'}" Foreground="{StaticResource BrushSuccess}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,2" />
                                <TextBlock Text="32 Dedicated Slots" Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 3: Realm Uptime -->
                        <Border Grid.Column="4" Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="SESSION UPTIME" Foreground="{StaticResource BrushTextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Liveboard.UptimeFormatted, StringFormat='Uptime: {0}', FallbackValue='Uptime: 00m 00s'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,2" />
                                <TextBlock Text="Dedicated Instance" Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 4: Server Health & FPS -->
                        <Border Grid.Column="6" Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="TICKRATE &amp; HEALTH" Foreground="{StaticResource BrushTextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Liveboard.FpsBadge, FallbackValue='60 FPS'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Liveboard.PerformanceHealthText, FallbackValue='🟢 Optimal'}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Active Players Presence Roster -->
                    <Border Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PIONEERS IN REALM" Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8" />

                            <!-- Active Player List (Visible when players > 0) -->
                            <ItemsControl ItemsSource="{Binding Liveboard.Players}" Visibility="{Binding Liveboard.HasActivePlayers, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121824" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" />
                                                <Border Background="#202A3C" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding LevelBadge}" Foreground="{StaticResource BrushAccentCyan}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PingBadge}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Location}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Standby Empty State (Visible when 0 players) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Liveboard.HasNoPlayers, Converter={StaticResource BoolToVis}}" Margin="0,2,0,2">
                                <Path Data="{StaticResource IconPlay}" Fill="{StaticResource BrushTextMuted}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="No active pioneers currently in realm. Server is standing by — auto-wake activates on launch." Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

