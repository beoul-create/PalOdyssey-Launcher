<UserControl x:Class="PalLauncher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PalLauncher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="860">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,16">

            <!-- Minimalist Hero Banner Card -->
            <Border CornerRadius="10" Margin="0,0,0,16" Background="{StaticResource BrushCardGlowGradient}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Header & Announcement -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="EXPEDITION REALM" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#101827" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.5.4" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Ready for the Next Expedition" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding NewsAnnouncement}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" MaxWidth="540" LineHeight="16" />
                    </StackPanel>

                    <!-- Right: Minimal Server Endpoint Pill -->
                    <Border Grid.Column="1" Background="#0E131C" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="DEFAULT SERVER" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SettingsVM.ServerIp}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text=":" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                                <TextBlock Text="{Binding SettingsVM.ServerPort}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                            </StackPanel>
                            <Button Content="Server Config" Style="{StaticResource StyleGhostButton}" Padding="8,3" FontSize="10" HorizontalAlignment="Left"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Minimalist 3-Card Status Overview -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Palworld Client Status -->
                <Border Grid.Column="0" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="GAME CLIENT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SettingsVM.PathStatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SettingsVM.CurrentPathInfo.DetectedSource, StringFormat='Source: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Palworld Dedicated Server Status -->
                <Border Grid.Column="2" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="DEDICATED REALM" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="beoul.duckdns.org:8211" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ServerStatusBadgeText}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Launch Profile -->
                <Border Grid.Column="4" Style="{StaticResource StyleCardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="LAUNCH MODE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#101827" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="Simultaneous Boot" Foreground="{StaticResource BrushAccentOrange}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border Background="#101827" CornerRadius="4" Padding="6,2" Visibility="{Binding SettingsVM.UseDirectX11, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DX11" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Direct client &amp; server execution active" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Server Liveboard & Active Player Roster Panel -->
            <Border Style="{StaticResource StyleCardBorder}" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconServer}" Fill="{StaticResource BrushAccentCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="PALODYSSEY REALM LIVEBOARD" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Telemetry Badges (Uptime & Auto-Shutdown) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Online Uptime -->
                            <Border Background="#101827" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="UPTIME: " Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Liveboard.UptimeFormatted}" Foreground="{StaticResource BrushTextPrimary}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>

                            <!-- Auto-Shutdown Indicator -->
                            <Border Background="#162030" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Liveboard.AutoShutdownStatusText}" Foreground="{StaticResource BrushAccentCyan}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Player Count & Roster Display -->
                    <Border Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="EXPEDITION ROSTER" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Liveboard.PlayerCountSummary}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Player ItemsControl (Active Roster) -->
                            <ItemsControl ItemsSource="{Binding Liveboard.Players}" Visibility="{Binding Liveboard.HasActivePlayers, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#101827" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Border Background="{StaticResource BrushAccentCyan}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LevelBadge}" Foreground="#0A0E17" FontSize="9" FontWeight="ExtraBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PingBadge}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state message if 0 players -->
                            <TextBlock Text="No players currently in realm. Ready for launch." Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontStyle="Italic" Margin="0,2,0,0" Visibility="{Binding Liveboard.HasNoPlayers, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Real-time Live Log & Realm Feed -->
            <Border Style="{StaticResource StyleCardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="REALM CONSOLE STREAM" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#090D14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" MinHeight="110">
                        <ListBox ItemsSource="{Binding LogsVM.LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontFamily="Consolas" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Source, StringFormat='[{0}]'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
