<UserControl x:Class="PalLauncher.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="860">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Actions Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Filter chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    
                    <RadioButton Content="All Logs" GroupName="LogsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11" IsChecked="True"
                                 Click="OnFilterAllClicked" />
                    <RadioButton Content="Server Logs" GroupName="LogsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                 Click="OnFilterServerClicked" />
                    <RadioButton Content="Errors" GroupName="LogsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                 Click="OnFilterErrorsClicked" />
                    <RadioButton Content="Warnings" GroupName="LogsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                 Click="OnFilterWarningsClicked" />
                    <RadioButton Content="Success" GroupName="LogsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                 Click="OnFilterSuccessClicked" />
                </StackPanel>

                <!-- Right: Tool Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy Logs" Style="{StaticResource StyleGhostButton}" Margin="0,0,8,0"
                            Command="{Binding CopyLogsCommand}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Copy to Clipboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Open Logs Folder" Style="{StaticResource StyleGhostButton}" Margin="0,0,8,0"
                            Command="{Binding OpenLogFolderCommand}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Logs Folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Style="{StaticResource StyleGhostButton}"
                            Command="{Binding ClearLogsCommand}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dark Terminal Output Window -->
        <Border Grid.Row="1" Background="#080B10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ListBox x:Name="LogsListBox"
                     ItemsSource="{Binding FilteredLogsView}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}" Foreground="#64748B" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0" />
                            <Border Background="#1A2333" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Level}" Foreground="{Binding LevelColor}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Width="52" TextAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Source, StringFormat='[{0}]'}" Foreground="{StaticResource BrushAccentCyan}" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextPrimary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
