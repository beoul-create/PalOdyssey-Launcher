<UserControl x:Class="PalLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PalLauncher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="860">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:FileSizeConverter x:Key="FileSizeConv" />
        <converters:ProgressPercentageConverter x:Key="ProgressConv" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
        <converters:ModStatusToColorConverter x:Key="ModStatusToColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Summary & Actions Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushCardGlowGradient}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Summary & Action Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="PALODYSSEY EXPEDITION MODPACK (v1.5.4)" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#101827" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalModsCount}" Foreground="{StaticResource BrushSuccess}" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" />
                                    <TextBlock Text="Paks &amp; Scripts Loaded" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Curated modification suite and gameplay expansions for the PalOdyssey realm." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                    </StackPanel>

                    <!-- Right Action Button: Open Mods Folder -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StyleGhostButton}" FontSize="11" Padding="12,6"
                                Command="{Binding OpenModsFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open Mods Folder" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Filter Chips -->
                <Border Grid.Row="1" Background="#0C1017" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <RadioButton Content="All Mods" GroupName="ModsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11" IsChecked="True"
                                     Click="OnFilterAllClicked" />
                        <RadioButton Content="Required Core" GroupName="ModsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                     Click="OnFilterRequiredClicked" />
                        <RadioButton Content="Pending Updates" GroupName="ModsFilterGroup" Style="{StaticResource StyleNavRadioButton}" Padding="10,4" FontSize="11"
                                     Click="OnFilterUpdatesClicked" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Responsive Mod Cards List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding FilteredModsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Header & Status Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Mod Title & Badges -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPackage}" Fill="{StaticResource BrushAccentCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        
                                        <Border Background="#253248" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>

                                        <Border Background="#3B2612" CornerRadius="4" Padding="6,2" Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                            <TextBlock Text="REQUIRED" Foreground="{StaticResource BrushAccentOrange}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Pill Badge -->
                                    <Border Grid.Column="1" Background="#121824" BorderBrush="{Binding Status, Converter={StaticResource ModStatusToColorConverter}}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource ModStatusToColorConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusDisplayName}" Foreground="{Binding Status, Converter={StaticResource ModStatusToColorConverter}}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: Description & Metadata -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8" />
                                    
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Install Path: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding RelativeInstallPath}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" Margin="0,0,16,0" />

                                        <TextBlock Text="Size: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSizeConv}}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,16,0" />

                                        <TextBlock Text="SHA-256: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding Sha256Checksum}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

