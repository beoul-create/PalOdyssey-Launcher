<UserControl x:Class="PalLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PalLauncher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="880">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:BooleanToBrushConverter x:Key="PathValidToBrush" TrueBrush="{StaticResource BrushSuccess}" FalseBrush="{StaticResource BrushWarning}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,16">

            <!-- Section 1: Game Installation Path -->
            <Border Style="{StaticResource StyleCardBorder}" Margin="0,0,0,14" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccentCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Palworld Installation Path" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleDarkTextBox}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource StyleGhostButton}" VerticalAlignment="Center" Command="{Binding BrowsePathCommand}" />
                    </Grid>

                    <!-- Path Detection Status Badge -->
                    <Border Background="#0E1422" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheckCircle}" Fill="{StaticResource BrushSuccess}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsPathValid, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PathStatusText}" Foreground="{Binding IsPathValid, Converter={StaticResource PathValidToBrush}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 2: 1-Click Game & Engine Auto-Optimizer -->
            <Border CornerRadius="12" Margin="0,0,0,14" Background="{StaticResource BrushCardGlowGradient}" BorderBrush="{StaticResource BrushCyberBorderGradient}" BorderThickness="1.5" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#00F0FF" Opacity="0.2" />
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconRocket}" Fill="{StaticResource BrushAccentCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Game &amp; Engine Performance Suite" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Automatic hardware profiling, CPU thread scheduling, raw mouse input, and network uncapping." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        </StackPanel>

                        <!-- Hardware Tier Badge -->
                        <Border Grid.Column="1" Background="#142035" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HardwareProfile.PerformanceTier, FallbackValue='ENHANCED'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Detected Rig Specs Card -->
                    <Border Background="#090E17" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="DETECTED HARDWARE:" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding HardwareProfile.SummaryText, FallbackValue='Detecting System Specs...'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding HardwareProfile.RecommendationSummary, FallbackValue='Ready to optimize game engine'}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Primary 1-Click Auto-Optimize Button -->
                    <Button Style="{StaticResource StyleLaunchButton}"
                            Command="{Binding AutoOptimizeFlagsCommand}"
                            Padding="24,14" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconRocket}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="⚡ AUTO-OPTIMIZE GAME &amp; ENGINE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Section 3: Preferences & Integrations -->
            <Border Style="{StaticResource StyleCardBorder}" Margin="0,0,0,14" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Launcher Preferences" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <CheckBox Content="🎮 Discord Rich Presence (Displays live status &amp; mod telemetry in Discord)"
                              Style="{StaticResource StyleDarkCheckBox}"
                              IsChecked="{Binding EnableDiscordRpc}"
                              Margin="0,0,0,10" />

                    <CheckBox Content="Close launcher automatically after launching game"
                              Style="{StaticResource StyleDarkCheckBox}"
                              IsChecked="{Binding CloseLauncherOnLaunch}"
                              Margin="0,0,0,10" />

                    <CheckBox Content="Auto-update modpack before launching"
                              Style="{StaticResource StyleDarkCheckBox}"
                              IsChecked="{Binding AutoUpdateBeforeLaunch}"
                              Margin="0,0,0,6" />
                </StackPanel>
            </Border>

            <!-- Bottom Actions Bar -->
            <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Reset Defaults" Style="{StaticResource StyleGhostButton}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,10,0" Padding="12,6" />
                        <Button Content="Save Settings" Style="{StaticResource StyleCyanButton}" Command="{Binding SaveSettingsCommand}" Padding="16,6" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
