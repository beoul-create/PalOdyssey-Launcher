<Window x:Class="PalLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PalLauncher.Views"
        xmlns:converters="clr-namespace:PalLauncher.Converters"
        mc:Ignorable="d"
        Title="PalOdyssey Futuristic Game Launcher"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="720" Width="1080"
        MinHeight="660" MinWidth="980"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:ProgressPercentageConverter x:Key="ProgressConv" />
    </Window.Resources>

    <!-- Outer Window Holographic Glow & Cyber Border -->
    <Border Margin="12" Background="{StaticResource BrushBgVoid}" CornerRadius="16" BorderBrush="{StaticResource BrushCyberBorderGradient}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#00F0FF" Opacity="0.35" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Futuristic Chrome Header -->
                <RowDefinition Height="*" />    <!-- Rotating Hologram Views -->
                <RowDefinition Height="Auto" /> <!-- Bottom Holographic Command Deck -->
            </Grid.RowDefinitions>

            <!-- 1. Holographic Top Navigation Chrome -->
            <Border Grid.Row="0" Background="{StaticResource BrushHeaderGradient}" CornerRadius="15,15,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Height="60" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Astralym Brand Emblem & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Cursor="SizeAll">
                        <Border Width="36" Height="36" CornerRadius="10" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1.5" Margin="0,0,12,0" Background="#0C1018">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#00F0FF" Opacity="0.8" ShadowDepth="0" />
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/astralym_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="1" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PALODYSSEY" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#162035" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ASTRAL v2.0" Foreground="{StaticResource BrushAccentCyan}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Next-Gen Realm Engine" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Holographic Rotating Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="TabDashboard" Content="Dashboard" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsDashboardActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="DASHBOARD" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton x:Name="TabMods" Content="Mods" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsModsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Mods"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPackage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="MODPACK" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton x:Name="TabSettings" Content="Settings" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsSettingsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="SETTINGS" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton x:Name="TabLogs" Content="Logs" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsLogsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="LOGS" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>

                    <!-- Right: Window Min / Max / Close Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StyleChromeButton}" Tag="{StaticResource IconMinimize}" Command="{Binding MinimizeCommand}" />
                        <Button Style="{StaticResource StyleChromeButton}" Tag="{StaticResource IconMaximize}" Command="{Binding MaximizeCommand}" />
                        <Button Style="{StaticResource StyleChromeCloseButton}" Tag="{StaticResource IconClose}" Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Holographic Viewport (Smooth Rotating Panel Transition) -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgDark}" Padding="22,16" ClipToBounds="True">
                <Grid>
                    <!-- Dashboard View Container -->
                    <Grid x:Name="ViewDashboard" Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                        <local:DashboardView DataContext="{Binding}" />
                    </Grid>

                    <!-- Mods Management View Container -->
                    <Grid x:Name="ViewMods" Visibility="{Binding IsModsActive, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                        <local:ModsView DataContext="{Binding ModsVM}" />
                    </Grid>

                    <!-- Settings View Container -->
                    <Grid x:Name="ViewSettings" Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                        <local:SettingsView DataContext="{Binding SettingsVM}" />
                    </Grid>

                    <!-- Logs View Container -->
                    <Grid x:Name="ViewLogs" Visibility="{Binding IsLogsActive, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                        <local:LogsView DataContext="{Binding LogsVM}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Bottom Holographic Command Deck -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" CornerRadius="0,0,15,15" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Indicator & Update Progress -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <!-- Progress Bar (Visible during downloads) -->
                        <Grid Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                            <ProgressBar Value="{Binding UpdateProgressPercentage}" Maximum="100" Height="6" Style="{StaticResource StyleGlowProgressBar}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentCyan}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentOrange}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#00F0FF" Opacity="0.8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Quick Action Controls & Launch Engine -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sync Mods Button -->
                        <Button Style="{StaticResource StyleGhostButton}"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBoolToVis}}"
                                Margin="0,0,12,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushAccentCyan}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SYNC REALM" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Primary Launch Button with Astral Hologram Glow -->
                        <Button Style="{StaticResource StyleLaunchButton}"
                                Command="{Binding LaunchGameCommand}"
                                IsEnabled="{Binding CanLaunch}"
                                MinWidth="180">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconRocket}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="LAUNCH GAME" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
