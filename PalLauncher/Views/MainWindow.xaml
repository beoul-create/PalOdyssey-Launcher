<Window x:Class="PalLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PalLauncher.Views"
        xmlns:converters="clr-namespace:PalLauncher.Converters"
        mc:Ignorable="d"
        Title="PalOdyssey Custom Game Launcher"
        Height="700" Width="1060"
        MinHeight="640" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:ProgressPercentageConverter x:Key="ProgressConv" />
    </Window.Resources>

    <!-- Outer Window Drop Shadow Border -->
    <Border Margin="10" Background="{StaticResource BrushBgVoid}" CornerRadius="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Window Chrome Header -->
                <RowDefinition Height="*" />    <!-- Content Tab Views -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action / Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Minimalist Header & Window Chrome -->
            <Border Grid.Row="0" Background="{StaticResource BrushHeaderGradient}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Height="52" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sleek Brand Logo & Title (Draggable Area) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Cursor="SizeAll">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource BrushLaunchGradient}" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconRocket}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PALODYSSEY" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#162030" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="1.5.4" Foreground="{StaticResource BrushAccentCyan}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Minimalist Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton Content="Dashboard" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsDashboardActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Content="Mods &amp; Paks" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsModsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Mods"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPackage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Mods" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Content="Settings" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsSettingsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Content="Logs" GroupName="NavTabs" Style="{StaticResource StyleNavRadioButton}"
                                     IsChecked="{Binding IsLogsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                     Checked="OnNavTabChecked" Click="OnNavTabClick">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Logs" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>

                    <!-- Right: Window Min / Max / Close Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StyleChromeButton}" Tag="{StaticResource IconMinimize}" Command="{Binding MinimizeCommand}" />
                        <Button Style="{StaticResource StyleChromeButton}" Tag="{StaticResource IconMaximize}" Command="{Binding MaximizeCommand}" />
                        <Button Style="{StaticResource StyleChromeCloseButton}" Tag="{StaticResource IconClose}" Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Content View Area -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgDark}" Padding="20,16">
                <Grid>
                    <!-- Dashboard View -->
                    <Grid Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVis}}">
                        <local:DashboardView DataContext="{Binding}" />
                    </Grid>

                    <!-- Mods Management View -->
                    <Grid Visibility="{Binding IsModsActive, Converter={StaticResource BoolToVis}}">
                        <local:ModsView DataContext="{Binding ModsVM}" />
                    </Grid>

                    <!-- Settings View -->
                    <Grid Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}">
                        <local:SettingsView DataContext="{Binding SettingsVM}" />
                    </Grid>

                    <!-- Logs View -->
                    <Grid Visibility="{Binding IsLogsActive, Converter={StaticResource BoolToVis}}">
                        <local:LogsView DataContext="{Binding LogsVM}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Bottom Action & Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Info & Progress -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <!-- Status Indicator Pulse Dot -->
                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Percentage text -->
                            <TextBlock Text="{Binding ProgressPercentage, Converter={StaticResource ProgressConv}}"
                                       Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- Global Progress Bar -->
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Style="{StaticResource StyleGlowingProgressBar}" Height="6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Right: Big Launch Expedition Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource StyleLaunchButton}"
                            Command="{Binding LaunchGameCommand}"
                            Height="48"
                            MinWidth="220"
                            VerticalAlignment="Center">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRocket}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LaunchButtonText}" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
