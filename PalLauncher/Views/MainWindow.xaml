<Window x:Class="PalLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PalLauncher.ViewModels"
        mc:Ignorable="d"
        Title="PalOdyssey Launcher"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="700" Width="1160"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Glow Drop Shadow Effect for Buttons -->
        <DropShadowEffect x:Key="CyanButtonGlow" Color="#00F0FF" BlurRadius="22" ShadowDepth="0" Opacity="0.65" />
        <DropShadowEffect x:Key="AmberButtonGlow" Color="#F59E0B" BlurRadius="22" ShadowDepth="0" Opacity="0.75" />
        <DropShadowEffect x:Key="GreenButtonGlow" Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
        <DropShadowEffect x:Key="RedButtonGlow" Color="#EF4444" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />

        <!-- TitleBar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#22304A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Card Style -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#660F172A" />
            <Setter Property="BorderBrush" Value="#4438BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Action Button Style with Stateful Animations -->
        <Style x:Key="HeroPlayButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Width" Value="280" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glow Shadow Border -->
                            <Border x:Name="glowBorder" CornerRadius="12" Background="{StaticResource HeroGradientBrush}"
                                    Effect="{StaticResource CyanButtonGlow}">
                            </Border>

                            <!-- Button Face -->
                            <Border x:Name="faceBorder" CornerRadius="12" Background="{StaticResource HeroGradientBrush}"
                                    BorderBrush="#80FFFFFF" BorderThickness="1.5" Padding="20,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Play Icon -->
                                        <Path x:Name="btnIcon" Data="M0,0 L14,8 L0,16 Z" Fill="#FFFFFF" 
                                              VerticalAlignment="Center" Margin="0,0,12,0" Stretch="Uniform" Width="13" Height="15" />
                                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover Animation: Scale 1.025x + Glow Expansion -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="28" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.9" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="22" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.65" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="faceBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="faceBorder" Property="Opacity" Value="0.75" />
                                <Setter TargetName="glowBorder" Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- State-Based Dynamic Style Triggers via ViewModel CurrentState -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState}" Value="VerifyingIntegrity">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="pulseAmberBorder" CornerRadius="12" Background="#D97706"
                                            Effect="{StaticResource AmberButtonGlow}">
                                    </Border>
                                    <Border CornerRadius="12" Background="#B45309" BorderBrush="#FCD34D" BorderThickness="1.5" Padding="20,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Pulsing animation for integrity check -->
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="pulseAmberBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                 From="0.3" To="0.9" Duration="0:0:0.7" />
                                                <DoubleAnimation Storyboard.TargetName="pulseAmberBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                 From="12" To="30" Duration="0:0:0.7" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentState}" Value="GameRunning">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border CornerRadius="12" Background="#065F46" Effect="{StaticResource GreenButtonGlow}" />
                                    <Border CornerRadius="12" Background="#047857" BorderBrush="#6EE7B7" BorderThickness="1.5" Padding="20,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="#34D399" Margin="0,0,10,0" />
                                            <TextBlock Text="GAME RUNNING" VerticalAlignment="Center" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Glowing Progress Bar Style -->
        <Style x:Key="GlowingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Track" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{StaticResource HeroGradientBrush}"
                                    Effect="{StaticResource CyanButtonGlow}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Shell with Drop Shadow -->
    <Border CornerRadius="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.75" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.Clip>
                <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,1140,680" />
            </Grid.Clip>

            <!-- LAYER 0: Background Ambient Video Loop with Fallback Ambient Color -->
            <Border Background="{StaticResource BgDarkBrush}" />

            <MediaElement x:Name="BackgroundVideo"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          IsMuted="True"
                          Stretch="UniformToFill"
                          Opacity="0.95"
                          MediaEnded="BackgroundVideo_MediaEnded"
                          MediaFailed="BackgroundVideo_MediaFailed" />

            <!-- Ambient Glow Auras -->
            <Ellipse Width="600" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-100,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#2500E5FF" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="600" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-100">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#254F46E5" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- LAYER 1: Glassmorphic Gradient Overlay -->
            <Border Background="{StaticResource GlassBackgroundBrush}" />

            <!-- LAYER 2: Main Application UI Layout -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Custom Draggable Header / Titlebar -->
                    <RowDefinition Height="50" />
                    <!-- Row 1: Main Dashboard Content Area -->
                    <RowDefinition Height="*" />
                    <!-- Row 2: Bottom Hero Action / Sync Dock -->
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>

                <!-- ================= TITLE BAR ================= -->
                <Grid Grid.Row="0" Background="#800B1220" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource HeroGradientBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⚔" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PALODYSSEY" Foreground="#FFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
                        <TextBlock Text=" // V2.0 LAUNCHER" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,1,0,0" />
                    </StackPanel>

                    <!-- Center: Dedicated Server Status Beacon & Quick Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#1A0F172A" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="12" Padding="12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ServerStatusIndicator"
                                         Width="8" Height="8"
                                         Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="DEDICATED SERVER:" 
                                           FontWeight="Bold" 
                                           Foreground="#94A3B8" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ServerStatusText" 
                                           Text="OFFLINE" 
                                           FontWeight="SemiBold" 
                                           Foreground="#EF4444" 
                                           FontSize="11" 
                                           Margin="6,0,10,0" 
                                           VerticalAlignment="Center"/>

                                <!-- Locate Server Button (If not detected) -->
                                <Button x:Name="BtnSelectServerPath"
                                        Content="Locate"
                                        Margin="0,0,8,0"
                                        Padding="8,2"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Background="#1E293B"
                                        Foreground="#38BDF8"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnSelectServerPath_Click"
                                        MouseEnter="PlayHoverSound"
                                        Visibility="Collapsed">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- Start / Stop Server Toggle Button -->
                                <Button x:Name="BtnServerToggle"
                                        Content="Start Server"
                                        Padding="10,3"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Background="#0284C7"
                                        Foreground="#FFFFFF"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnServerToggle_Click"
                                        MouseEnter="PlayHoverSound">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Window Navigation & Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Discord Link -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Command="{Binding OpenDiscordCommand}"
                                ToolTip="Join Palworld Community Discord" MouseEnter="PlayHoverSound">
                            <TextBlock Text="💬" FontSize="13" />
                        </Button>

                        <!-- Settings Toggle -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Command="{Binding ToggleSettingsCommand}"
                                ToolTip="Launcher Settings" MouseEnter="PlayHoverSound">
                            <TextBlock Text="⚙" FontSize="14" />
                        </Button>

                        <Separator Style="{x:Null}" Margin="4,8" Width="1" Background="#22304A" />

                        <!-- Minimize Button -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click"
                                ToolTip="Minimize" MouseEnter="PlayHoverSound">
                            <TextBlock Text="—" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"
                                ToolTip="Close Launcher" MouseEnter="PlayHoverSound">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= MAIN CONTENT DASHBOARD ================= -->
                <Grid Grid.Row="1" Margin="28,20,28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Server Hero Banner & News Feeds -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Server Branding Card -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="22,18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="EXPEDITION REALM" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="PALODYSSEY DEDICATED" Foreground="#FFFFFF" FontSize="26" FontWeight="Black" Margin="0,2,0,4" />
                                    <TextBlock Text="Custom Pal breeds, enhanced raid bosses, high-tier loot drops, and fast-paced base building." 
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Border Background="#1E293B" CornerRadius="8" Padding="12,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="SERVER PING" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ServerPingText}" Foreground="{Binding ServerPingBrush}" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- News & Patch Notes Card -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="📰" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ANNOUNCEMENTS &amp; PATCH NOTES" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding NewsItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#40131B2B" BorderBrush="#22304A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="16" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT COLUMN: Modpack Info & Configuration -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Modpack Features & Status Card -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="MODPACK STATUS" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Active Modifications" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,2,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PalOdyssey Core Engine" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Installed" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UE4SS Script Loader" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Synced" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Custom HUD &amp; MiniMap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="v2.0.4" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cryptographic Hashing" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="SHA-256 Validated" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" />
                                </Grid>

                                <Border Background="#2038BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="ℹ Server sync automatically checks and downloads required assets into your Palworld game folder."
                                               Foreground="{StaticResource AccentCyanBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="15" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Game Path Selector Card -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GAME DIRECTORY" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" />
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseGamePathCommand}"
                                            Background="#22304A" Foreground="#FFFFFF" BorderThickness="0" Padding="8,2" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                            MouseEnter="PlayHoverSound">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <TextBox Text="{Binding GamePath, Mode=TwoWay}" IsReadOnly="True"
                                         Background="#101726" Foreground="#CBD5E1" BorderBrush="#22304A" BorderThickness="1"
                                         Padding="8,6" FontSize="11" FontFamily="Consolas, monospace" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= BOTTOM HERO ACTION DOCK ================= -->
                <Grid Grid.Row="2" Background="#99060A14" VerticalAlignment="Stretch">
                    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" />

                    <Grid Margin="28,14,28,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Status ticker & Progress Bar -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="15" FontWeight="Black" />
                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="6,0"
                                           Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{Binding DownloadSpeedText}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold"
                                           Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>

                            <!-- Sub-status description or file ticker -->
                            <TextBlock Text="{Binding SubStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

                            <!-- Glowing Progress Bar -->
                            <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar Grid.Row="0" Style="{StaticResource GlowingProgressBarStyle}" Value="{Binding DownloadPercentage}" Maximum="100" />
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadPercentage, StringFormat={}{0:F0}%}" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="Bold" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Stateful Hero Play Button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource HeroPlayButtonStyle}"
                                    Content="{Binding ActionButtonText}"
                                    Command="{Binding PlayCommand}"
                                    IsEnabled="{Binding IsActionEnabled}"
                                    MouseEnter="PlayHoverSound" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= SETTINGS FLYOUT OVERLAY ================= -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Background="#B3050811"
                      Visibility="{Binding IsSettingsFlyoutOpen, Converter={StaticResource BoolToVisConverter}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                            Style="{StaticResource GlassCardStyle}" Background="#F00B1220" Padding="24" BorderBrush="#00E5FF" BorderThickness="1.5">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LAUNCHER SETTINGS" Foreground="#FFFFFF" FontSize="16" FontWeight="Black" />
                                <Button Grid.Column="1" Content="✕" Command="{Binding ToggleSettingsCommand}"
                                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" />
                            </Grid>

                            <!-- Manifest URL -->
                            <TextBlock Text="Remote Manifest URL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RemoteManifestUrl, Mode=TwoWay, FallbackValue=https://palodyssey.gg/manifest.json}"
                                     Background="#101726" Foreground="#FFFFFF" BorderBrush="#22304A" BorderThickness="1" Padding="8" FontSize="12" Margin="0,0,0,14" />

                            <!-- Audio & Discord Toggles -->
                            <CheckBox IsChecked="{Binding IsSoundEnabled, Mode=TwoWay}" Margin="0,0,0,10" Cursor="Hand">
                                <TextBlock Text="Enable Sound Effects (Hover &amp; Click Audio)" Foreground="#FFFFFF" FontSize="12" Margin="6,0,0,0" />
                            </CheckBox>

                            <CheckBox IsChecked="{Binding IsDiscordRpcEnabled, Mode=TwoWay}" Margin="0,0,0,16" Cursor="Hand">
                                <TextBlock Text="Enable Discord Rich Presence" Foreground="#FFFFFF" FontSize="12" Margin="6,0,0,0" />
                            </CheckBox>

                            <Button Content="DONE" Command="{Binding ToggleSettingsCommand}"
                                    Background="{StaticResource HeroGradientBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Height="38" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
