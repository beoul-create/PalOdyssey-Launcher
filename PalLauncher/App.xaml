<Application x:Class="PalLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PalLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
            <converters:BooleanToBrushConverter x:Key="BoolToBrush" />
            <converters:BooleanToBrushConverter x:Key="PathValidToBrush" TrueBrush="{StaticResource BrushSuccess}" FalseBrush="{StaticResource BrushWarning}" />
            <converters:FileSizeConverter x:Key="FileSizeConv" />
            <converters:ProgressPercentageConverter x:Key="ProgressConv" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
            <converters:ModStatusToColorConverter x:Key="ModStatusToColorConverter" />
            <converters:ModStatusToColorConverter x:Key="ModStatusToColorConv" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
