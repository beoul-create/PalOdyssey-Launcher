[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
TestResults/
*.trx
coverage/

# Visual Studio & IDE files
.vs/
.vscode/
.idea/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
*.cache
*.dbmdl

# Operating System & Temp Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.log
*.benchmark_backup

# Breakpad minidumps and crash logs
*.dmp
*.mdmp
*.pdb

# Local benchmark output & submodules
benchmark_*.json
project_test_results*.json
test_download/
GitHub-Modpack-Release/
publish/
MockGame/


