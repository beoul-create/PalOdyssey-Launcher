## .gitignore for PalOdyssey (.NET 8 WPF / Visual Studio / C#)

# Build and Output Directories
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
TestResults/
*.trx
coverage/

# Visual Studio & IDE files
.vs/
.vscode/
.idea/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
*.cache
*.dbmdl

# Operating System & Temp Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.log
*.benchmark_backup
*.zip


# Breakpad minidumps and crash logs
*.dmp
*.mdmp
*.pdb

# Developer local scripts
/run-dev.*
/[Dd]eploy-[Mm]odpack.*
/Install-PalOdyssey-*
dev-tools/
server-tools/
tools/



# Local benchmark output & submodules
benchmark_*.json
project_test_results*.json
test_download/
GitHub-Modpack-Release/
publish/
# Local Secrets, Credentials & Server Runtime Files
bot_token.txt
*.token
liveboard_state.json
account-links.json
guild-licenses.json
pending-deliveries.*
pending-deliveries.csv
pending-deliveries.json
*.sav
SaveGames/
Saved/

# Root build artifacts
/*.deps.json
/*.runtimeconfig.json
/*.dll
/*.exe
/runtimes/
SampleData/



