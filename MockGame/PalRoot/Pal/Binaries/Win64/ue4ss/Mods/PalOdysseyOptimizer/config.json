{
  "preset": "ultra_optimal",
  "rawInput": {
    "enabled": true,
    "disableSmoothing": true,
    "disableAcceleration": true
  },
  "network": {
    "enabled": true,
    "maxBandwidth": 2097152,
    "minBandwidth": 131072,
    "maxNetSerializePerFrame": 10000,
    "reliableRetryDelay": 0.03
  },
  "graphics": {
    "enabled": true,
    "enableGpuSkinning": true,
    "oneFrameThreadLag": true,
    "multithreadedShaders": true,
    "optimizeNaniteLumen": true,
    "shadowBudgetOptimization": true,
    "texturePoolStreamingDefrag": true,
    "asyncCompute": true
  },
  "cpu": {
    "enabled": true,
    "limitBackgroundCpu": false,
    "taskGraphTasksPerTick": 120,
    "gcIntervalSeconds": 90
  },
  "memory": {
    "enabled": true,
    "autoTrimWorkingSet": true,
    "trimIntervalMinutes": 3,
    "defragTexturePool": true
  },
  "server": {
    "enabled": true,
    "connectionTimeout": 120,
    "initialConnectTimeout": 180,
    "adaptiveReplication": true
  }
}

