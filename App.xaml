<Application x:Class="PalLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Global Colors & Brushes -->
        <Color x:Key="AccentCyanColor">#00F0FF</Color>
        <Color x:Key="AccentIndigoColor">#4F46E5</Color>
        <Color x:Key="AccentAmberColor">#F59E0B</Color>
        <Color x:Key="AccentEmeraldColor">#10B981</Color>
        <Color x:Key="BgDarkColor">#080C14</Color>
        <Color x:Key="BgCardColor">#131B2B</Color>
        <Color x:Key="BorderDarkColor">#22304A</Color>

        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <!-- Linear Accent Gradient -->
        <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0" />
            <GradientStop Color="#3B82F6" Offset="0.5" />
            <GradientStop Color="#6366F1" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40070B14" Offset="0.0" />
            <GradientStop Color="#250B1220" Offset="0.5" />
            <GradientStop Color="#6005080E" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#334155" Margin="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
